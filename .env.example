# Frontend: copy to .env.local. Demo needs no services or keys.
VITE_APP_MODE=demo
# Required only when VITE_APP_MODE=supabase; use the public publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Reserved switches; voice and food-photo workflows are not implemented.
VITE_ENABLE_VOICE=false
VITE_ENABLE_MENU_PHOTOS=false

# Supabase Edge runtime ONLY; configure APP_ORIGIN via Function secrets.
# APP_ORIGIN=https://your-project.pages.dev
# Supabase supplies these automatically. Never put real values in frontend files:
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional demo server process variables; Node does NOT load .env.local.
# DEMO_STAFF_PIN=1234
# DEMO_PORT=4174
# Vite's proxy expects 4174; align vite.config.ts if changing DEMO_PORT.

# Optional isolated load-test process variables; not loaded from this file:
# PILOT_ALLOW_WRITE=TEST_DATA_ONLY
# PILOT_MODE=demo
# PILOT_BASE_URL=http://127.0.0.1:4174
# PILOT_QR_TOKEN=
# PILOT_PUBLISHABLE_KEY=
# PILOT_WORKERS=20
# PILOT_ORDERS_PER_WORKER=5

# Optional bounded eight-table test (explicitly authorized test orders only):
# TABLE_TEST_BASE_URL=https://YOUR_PROJECT.supabase.co
# TABLE_TEST_ORIGIN=https://YOUR_SITE.pages.dev
# TABLE_TEST_PUBLIC_KEY=
# TABLE_TEST_ALLOW_WRITE=EIGHT_TABLES_AUTHORIZED
# Session tokens stay in ignored .local-data/; see docs/reports/2026-10-09-eight-table-test.md.

# Future voice service only; currently unused and unnecessary:
# GEMINI_API_KEY=
# GEMINI_MODEL=
